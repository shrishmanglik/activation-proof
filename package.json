{
  "name": "activation-proof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic activation assurance control plane for evidence-bound MarTech delivery.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:controls": "vitest run tests/controls",
    "test:accessibility": "playwright test tests/e2e/accessibility.spec.ts --project=desktop-chrome",
    "test:security": "vitest run tests/security",
    "test:recovery": "vitest run tests/recovery",
    "control:consent": "vitest run tests/controls/consent.control.test.ts",
    "e2e": "playwright test --project=desktop-chrome --project=mobile-chrome",
    "e2e:update-screenshot": "playwright test --project=screenshot"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
